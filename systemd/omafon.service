[Unit]
Description=Omafon – talking phone
After=sound.target dev-ttyAMA0.device
Wants=dev-ttyAMA0.device

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -m omafon.main --config /etc/omafon/config.yaml
WorkingDirectory=/opt/omafon
User=omafon
Group=omafon
SupplementaryGroups=audio dialout gpio i2c
# main loop hangs -> systemd restarts
WatchdogSec=30
Restart=always
RestartSec=2
# higher priority: the digit announcement must never stutter
Nice=-5
CacheDirectory=omafon

[Install]
WantedBy=multi-user.target
