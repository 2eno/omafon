[Unit]
Description=Omafon – sprechendes Telefon
After=sound.target dev-ttyAMA0.device
Wants=dev-ttyAMA0.device
# Ein Telefon gibt nie auf: kein Startlimit (sonst bliebe es nach ein paar
# schnellen Abstürzen, z. B. kaputtes Update vor dem Rückfall, für immer aus)
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# Wrapper wählt die aktive Version (/data/omafon/current nach App-Update, sonst /opt/omafon)
# und schaltet nach drei Fehlstarts einer neuen Version zurück.
ExecStart=/opt/omafon/systemd/omafon-start.sh
WorkingDirectory=/opt/omafon
User=omafon
Group=omafon
SupplementaryGroups=audio dialout gpio i2c
# Hauptschleife hängt -> systemd startet neu
WatchdogSec=30
Restart=always
RestartSec=2
# Höhere Priorität: Ziffernansage soll nie stocken
Nice=-5
CacheDirectory=omafon

# Härtung – nur Optionen, die GPIO/I²C, Audio, serielle Schnittstelle, Netz,
# D-Bus/polkit (WLAN-Neustart) und Updates in /data nicht stören.
# Bewusst NICHT gesetzt: SystemCallArchitectures=native (32-Bit-System auf
# 64-Bit-Kernel, Standard beim Zero 2 mit 32-Bit-OS, liefe gar nicht mehr),
# ProtectKernelTunables (sysfs-GPIO), MemoryDenyWriteExecute (Piper/onnxruntime),
# ProtectClock (Uhr-Prüfung per adjtimex, omafon/clock.py).
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Neue Dateien (Posteingang, Aufnahmen, Einstellungen) nur für den Dienst lesbar
UMask=0077

[Install]
WantedBy=multi-user.target
